# DFPanel Agent 镜像：一个容器同时可托管 frps 与 frpc
# 构建：docker build -f Dockerfile.agent -t dreamstation625/dfpanel-agent:latest .
# 运行：docker run -d --network host \
#        -e DFPANEL_URL=http://panel:7226 -e DFPANEL_NODE_KEY=xxx -e DFPANEL_NODE_SECRET=yyy \
#        -e DFPANEL_ROLES=frps,frpc -v /opt/dfpanel-agent:/var/lib/dfpanel-agent \
#        dreamstation625/dfpanel-agent:latest
#
# 说明：
#   镜像不内置 frp —— frp 二进制由面板下发，Agent 需要时自动从面板下载并缓存到数据目录。
#   DFPANEL_RUNTIME=process（默认）：容器内直接拉起 frps / frpc 子进程
#   DFPANEL_RUNTIME=docker          ：通过 docker CLI 以容器方式运行 frps / frpc，
#                                     需要挂 /var/run/docker.sock，且数据目录要用**宿主机路径**
#                                     不能用命名卷 —— 容器里的配置与二进制要让宿主机的
#                                     docker daemon 也看得见，才能 bind-mount 进 frp 容器。

# ---------- 编译 Agent ----------
# 在构建机架构上交叉编译到目标架构（CGO 关闭），不经过 QEMU 模拟。
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS server
RUN apk add --no-cache git
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS=linux
ARG TARGETARCH=amd64
# Agent 版本取自 VERSION.agent，没有该文件时跟随面板版本 VERSION
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
    -ldflags "-X dfpanel/internal/agent.Version=$(if [ -s VERSION.agent ]; then cat VERSION.agent; else cat VERSION; fi)" -o /out/agent ./cmd/agent

# ---------- 运行 ----------
FROM alpine:3.20
# docker-cli：DFPANEL_RUNTIME=docker 时需要；curl/tar 供拉取 frp 二进制后解包
RUN apk add --no-cache ca-certificates tzdata curl tar docker-cli
ENV DFPANEL_DATA_DIR=/var/lib/dfpanel-agent \
    DFPANEL_RUNTIME=process \
    DFPANEL_ROLES=frpc \
    TZ=Asia/Shanghai
COPY --from=server /out/agent /usr/local/bin/dfpanel-agent
VOLUME ["/var/lib/dfpanel-agent"]
ENTRYPOINT ["dfpanel-agent"]
